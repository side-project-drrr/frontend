{
    "compilerOptions": {
        "target": "es5",
        "useDefineForClassFields": true,
        "lib": ["esnext", "DOM", "DOM.Iterable"],
        "module": "esnext",
        "skipLibCheck": true,
        "baseUrl": "src",
        "esModuleInterop": true,
        /* Bundler mode */
        "allowImportingTsExtensions": true,
        "resolveJsonModule": true,
        "isolatedModules": true,
        "noEmit": true,
        "jsx": "react-jsx",
        "moduleResolution": "Node",
        //"moduleResolution":"NodeNext",
        /* Linting */
        "strict": true,
        "noUnusedLocals": true,
        "noUnusedParameters": true,
        "noFallthroughCasesInSwitch": true
    },
    "include": [
        "./src/**/*",
        "../webpush/main.ts",
        "src",
        "tests",
        "types/TopPostType.ts",
        "types/CardType.ts",
        "types/CarouselType.ts",
        "types/CategoryType.ts",
        "types/CategoryModalType.ts",
        "types/RecommendType.ts",
        "types/SignUpType.ts",
        "types/social/SocialType.ts",
        "types/IndexIngType.ts",
        "types/ListBoxType.ts",
        "types/SocialServiceType.ts"
    ],
    "types": ["vite/client"]
}
